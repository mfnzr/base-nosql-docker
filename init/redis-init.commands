# REDIS INIT — DOMINGUEIRA  (padrão de chaves: domingueira:entidade:id)
# Executado pelo iniciar.sh depois que o container do Redis responde.

# Configurações globais (Hash)
HSET domingueira:config:app versao "1.0.0" cidade "Guarapuava" ttl_cache_loja_segundos "120"

# Categorias válidas de produto (Set — pertencimento em O(1))
SADD domingueira:categorias:ativas "Aves" "Carnes" "Espetos" "Pratos" "Padaria" "Laticínios" "Acompanhamentos"

# Ranking de produtos mais vendidos (Sorted Set: membro = produto_id, score = unidades/pedidos entregues)
ZADD domingueira:ranking:produtos 41 "670a1d4f8f3b4a5d6e7f8b01"
ZADD domingueira:ranking:produtos 33 "670a1d4f8f3b4a5d6e7f8b02"
ZADD domingueira:ranking:produtos 29 "670a1d4f8f3b4a5d6e7f8b11"
ZADD domingueira:ranking:produtos 24 "670a1d4f8f3b4a5d6e7f8b10"
ZADD domingueira:ranking:produtos 18 "670a1d4f8f3b4a5d6e7f8b13"

# Posição atual dos entregadores (GEO: longitude ANTES da latitude). Atualizada por PUT /api/entregadores/:id/posicao
GEOADD domingueira:entregadores:posicao -51.4605 -25.3940 "670a50008f3b4a5d6e7f8e01"
GEOADD domingueira:entregadores:posicao -51.4700 -25.3860 "670a50008f3b4a5d6e7f8e02"
GEOADD domingueira:entregadores:posicao -51.4420 -25.4030 "670a50008f3b4a5d6e7f8e03"
